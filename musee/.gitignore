# Réinstallés ou refaits : npm install, npm run build
node_modules
dist
*.tsbuildinfo

# Clé d'accès Vercel : jamais sur GitHub
.env*
.vercel

# Blender : copies de sauvegarde, calculs de lumière bruts (48 à 64 Mo chacun, recalculables
# avec salle.py ; les lightmaps finales sont dans public/models)
*.blend1
blender/salle/*.exr

# Fichiers temporaires
_a_supprimer
.DS_Store

# Copies locales de l’état d’une salle avant refonte (calculs de lumière bruts)
blender/sauvegardes
blender/sculpture/sculpture-raw.glb

# Salle de « La maladie de Huntington » : calculs de lumière bruts, export brut de l’œuvre
blender/salle-huntington/*.exr
blender/sculpture-huntington/huntington-raw.glb
blender/sculpture-huntington/huntington-jeff-raw.glb

# Sons d'origine (re-téléchargeables) : seules leurs versions compressées (public/assets/musiques) sont suivies
sons/*.mp3
sons/*.wav

# Aperçu de la rotonde (recalculable : blender/apercu-rotonde.py)
blender/rotonde-apercu.blend

# Rotonde de Huntington : calculs de lumière bruts (recalculables avec rotonde.py)
blender/salle-rotonde/*.exr
blender/salle-rotonde/*.blend1

# Rotonde : sortie intermédiaire du lissage (blender/lissage.py)
blender/salle-rotonde/lightmap-lisse.exr

# Pavillon de « Souffle d'éclats » : calculs de lumière bruts (recalculables avec pavillon.py), aperçu
# (apercu-pavillon.py), export brut de l'œuvre (souffle.py)
blender/salle-pavillon/*.exr
blender/pavillon-apercu.blend
blender/sculpture-souffle/souffle-raw.glb

# « Souffle d'éclats » : export brut des poumons du collègue (60 Mo, refait par poumons.py)
blender/sculpture-souffle/poumons-raw.glb

# Pillow pour chaine.sh, lancé par le bouton « Figer » de l’éclairage (vite.config.ts) ; journal du calcul
blender/.pylib
blender/salle-pavillon/figer.log
